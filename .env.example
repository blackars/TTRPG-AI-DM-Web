# TTRPG-Assistant — copia a api/.env y rellena lo que tengas.
# Sin claves, el asistente funciona en modo mock (cita datos reales y no crashea).

# Router de IA: auto | glm | local | openai | mock
DM_PROVIDER=auto
# auto = glm (si ZAI_KEY) -> local (Ollama) -> openai (si clave) -> mock

# Claves (vacías = proveedor no disponible)
ZAI_KEY=
OPENAI_API_KEY=

# Endpoints / modelos opcionales
#ZAI_BASE_URL=https://api.z.ai/api/paas/v4
#OPENAI_BASE_URL=https://api.openai.com/v1
#OLLAMA_BASE_URL=http://localhost:11434/v1
#GLM_TEXT_MODEL=glm-4.7-flash
#OPENAI_TEXT_MODEL=gpt-4.1-mini
#LOCAL_TEXT_MODEL=qwen2.5:3b

# Guardas de coste
MAX_CALLS_PER_HOUR=900
LLM_FAILS_TO_DEAD=3
LLM_DEAD_SECONDS=300

# MiniBase (M9). La app funciona sin esto; no la enciende ni la modifica.
# La API local de MiniBase escucha en 8000 (la web en 3000).
MINIBASE_URL=
MINIBASE_TOKEN=

# Base de datos alternativa (tests)
#TTRPG_DB=C:\ruta\assistant.db
